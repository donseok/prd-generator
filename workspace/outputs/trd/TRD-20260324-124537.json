{
  "id": "TRD-20260324-124537",
  "title": "시스템 모니터링 웹 대시보드 TRD",
  "executive_summary": "본 프로젝트는 단일 서버의 CPU, 메모리, 디스크, 네트워크 리소스를 실시간으로 시각화하는 웹 대시보드이다. React + Recharts 프론트엔드와 Python FastAPI + psutil 백엔드를 2-Tier 모놀리식 아키텍처로 구성한다. 인메모리 Ring Buffer로 최근 5분간의 시계열 데이터를 유지하며, 3초 간격 HTTP 폴링으로 실시간 데이터를 갱신한다. Docker 기반 배포로 환경 일관성을 확보한다.",
  "technology_stack": [
    {
      "category": "Frontend",
      "technologies": ["React 18.3", "TypeScript 5.x", "Vite 6.x", "Recharts 2.x", "Axios 1.x", "CSS Modules"],
      "rationale": "PRD 지정 기술(React, Recharts) 기반. TypeScript로 타입 안정성 확보, Vite로 빠른 개발 환경 구성."
    },
    {
      "category": "Backend",
      "technologies": ["Python 3.11+", "FastAPI 0.115", "psutil 6.x", "Uvicorn 0.32"],
      "rationale": "PRD 지정 기술(Python, psutil) 기반. FastAPI의 비동기 처리와 자동 API 문서 생성 활용."
    },
    {
      "category": "Infrastructure",
      "technologies": ["Docker 27.x", "Nginx 1.27", "docker-compose"],
      "rationale": "컨테이너 기반 배포로 환경 일관성 확보. Nginx로 정적 파일 서빙 및 API 프록시."
    }
  ],
  "system_architecture": {
    "overview": "프론트엔드 SPA와 백엔드 REST API로 구성된 2-Tier 모놀리식 아키텍처. Nginx가 리버스 프록시로 프론트엔드와 백엔드를 통합.",
    "architecture_style": "모놀리식",
    "layers": [
      {
        "name": "Presentation Layer",
        "description": "React SPA 기반 대시보드 UI. 4종 리소스를 차트로 시각화하고 3초 간격으로 자동 갱신.",
        "components": [
          {
            "name": "Dashboard",
            "type": "페이지 컴포넌트",
            "description": "4종 모니터링 차트를 그리드 레이아웃으로 배치하는 메인 대시보드",
            "responsibilities": ["차트 레이아웃 구성", "시스템 정보 헤더 표시"],
            "dependencies": ["CpuChart", "MemoryChart", "DiskChart", "NetworkChart", "useSystemStats"],
            "interfaces": []
          },
          {
            "name": "CpuChart",
            "type": "차트 컴포넌트",
            "description": "CPU 사용률 실시간 라인 차트",
            "responsibilities": ["CPU 사용률 시각화", "시간축 트렌드 표시"],
            "dependencies": ["Recharts LineChart"],
            "interfaces": ["props: { data: CpuData[], history: CpuHistory[] }"]
          },
          {
            "name": "MemoryChart",
            "type": "차트 컴포넌트",
            "description": "메모리 사용률 라인 차트 + 전체 대비 사용량 표시",
            "responsibilities": ["메모리 사용률 시각화", "전체/사용 용량 표시"],
            "dependencies": ["Recharts LineChart"],
            "interfaces": ["props: { data: MemoryData[], history: MemoryHistory[] }"]
          },
          {
            "name": "DiskChart",
            "type": "차트 컴포넌트",
            "description": "디스크 사용량 파이 차트 (드라이브별)",
            "responsibilities": ["디스크 사용/잔여 파이 차트", "드라이브별 개별 표시"],
            "dependencies": ["Recharts PieChart"],
            "interfaces": ["props: { data: DiskData[] }"]
          },
          {
            "name": "NetworkChart",
            "type": "차트 컴포넌트",
            "description": "네트워크 IN/OUT 트래픽 실시간 차트",
            "responsibilities": ["송수신 트래픽 구분 시각화", "단위 자동 변환"],
            "dependencies": ["Recharts LineChart"],
            "interfaces": ["props: { data: NetworkData[], history: NetworkHistory[] }"]
          },
          {
            "name": "useSystemStats",
            "type": "커스텀 훅",
            "description": "3초 간격 API 폴링, 데이터 상태 관리, 에러 핸들링",
            "responsibilities": ["3초 간격 자동 폴링", "데이터 캐싱", "에러 시 재시도"],
            "dependencies": ["Axios", "React hooks"],
            "interfaces": ["return: { stats, history, isLoading, error }"]
          }
        ]
      },
      {
        "name": "API Layer",
        "description": "FastAPI REST API. 시스템 리소스 정보를 JSON으로 제공.",
        "components": [
          {
            "name": "SystemRouter",
            "type": "API 라우터",
            "description": "시스템 정보 관련 API 엔드포인트 그룹",
            "responsibilities": ["엔드포인트 라우팅", "요청/응답 직렬화"],
            "dependencies": ["FastAPI", "SystemCollector"],
            "interfaces": ["GET /api/v1/system/stats", "GET /api/v1/system/stats/history", "GET /api/v1/system/info"]
          },
          {
            "name": "SystemCollector",
            "type": "서비스",
            "description": "psutil 래퍼. OS로부터 시스템 리소스 정보를 수집하여 구조화된 데이터로 반환.",
            "responsibilities": ["CPU/메모리/디스크/네트워크 데이터 수집", "네트워크 delta 계산", "데이터 정규화"],
            "dependencies": ["psutil"],
            "interfaces": ["get_snapshot() -> SystemSnapshot", "get_system_info() -> SystemInfo"]
          },
          {
            "name": "RingBuffer",
            "type": "데이터 저장소",
            "description": "인메모리 링 버퍼. 최근 100개(약 5분) 데이터 포인트를 FIFO로 관리.",
            "responsibilities": ["시계열 데이터 저장", "오래된 데이터 자동 삭제", "히스토리 조회"],
            "dependencies": ["collections.deque"],
            "interfaces": ["push(snapshot)", "get_history(limit) -> list"]
          }
        ]
      },
      {
        "name": "Infrastructure Layer",
        "description": "Nginx 리버스 프록시, Docker 컨테이너",
        "components": [
          {
            "name": "Nginx",
            "type": "리버스 프록시",
            "description": "프론트엔드 정적 파일 서빙 및 백엔드 API 프록시",
            "responsibilities": ["정적 파일 서빙", "API 프록시", "보안 헤더"],
            "dependencies": [],
            "interfaces": ["Port 80"]
          }
        ]
      }
    ],
    "data_flow": "1. SystemCollector가 psutil을 통해 OS에서 리소스 정보 수집 → 2. RingBuffer에 타임스탬프와 함께 인메모리 저장 → 3. FastAPI 엔드포인트가 현재 스냅샷 + 히스토리를 JSON 응답 → 4. React 프론트엔드가 3초 간격으로 폴링하여 Recharts로 렌더링",
    "deployment_diagram": "Docker Compose로 3개 컨테이너(nginx, frontend, backend) 구성. Nginx가 포트 80에서 요청을 받아 / 경로는 프론트엔드, /api 경로는 백엔드로 라우팅."
  },
  "database_design": {
    "database_type": "인메모리 (Ring Buffer)",
    "recommended_engine": "Python collections.deque",
    "entities": [
      {
        "name": "SystemSnapshot",
        "description": "특정 시점의 시스템 리소스 전체 스냅샷",
        "attributes": [
          "timestamp: datetime (수집 시각)",
          "cpu: CpuData (CPU 사용률, 코어 수)",
          "memory: MemoryData (메모리 사용률, 용량 정보)",
          "disk: list[DiskData] (파티션별 디스크 정보)",
          "network: NetworkData (네트워크 트래픽 정보)"
        ],
        "primary_key": "timestamp",
        "relationships": []
      }
    ],
    "indexing_strategy": "Ring Buffer의 deque 구조로 O(1) 삽입/삭제. 시간순 정렬 보장.",
    "partitioning_strategy": "해당 없음 (인메모리 구조)"
  },
  "api_specification": {
    "base_url": "/api/v1",
    "authentication_method": "없음 (PRD 범위 외)",
    "endpoints": [
      {
        "path": "/system/stats",
        "method": "GET",
        "description": "현재 시스템 리소스 스냅샷 조회",
        "request_body": null,
        "response_body": "{ timestamp, cpu: { usage_percent, core_count }, memory: { usage_percent, total_gb, used_gb, available_gb }, disk: [{ device, mountpoint, total_gb, used_gb, free_gb, usage_percent }], network: { bytes_sent, bytes_recv, bytes_sent_per_sec, bytes_recv_per_sec } }",
        "authentication": false,
        "related_requirement_id": "FR-001,FR-002,FR-003,FR-004,FR-005,FR-007"
      },
      {
        "path": "/system/stats/history",
        "method": "GET",
        "description": "최근 5분간 시계열 데이터 조회",
        "request_body": null,
        "response_body": "{ data: [{ timestamp, cpu, memory, network }], count, interval_seconds }",
        "authentication": false,
        "related_requirement_id": "FR-001,FR-002,FR-004"
      },
      {
        "path": "/system/info",
        "method": "GET",
        "description": "시스템 기본 정보 (OS, CPU 모델, 메모리 용량 등)",
        "request_body": null,
        "response_body": "{ hostname, os, os_version, cpu_model, cpu_cores, total_memory_gb, boot_time }",
        "authentication": false,
        "related_requirement_id": "FR-007"
      },
      {
        "path": "/health",
        "method": "GET",
        "description": "서버 헬스 체크",
        "request_body": null,
        "response_body": "{ status: 'healthy' }",
        "authentication": false,
        "related_requirement_id": ""
      }
    ],
    "common_headers": {
      "Content-Type": "application/json"
    },
    "error_handling": "{ error: { code: 'ERROR_CODE', message: '설명' } } 형식. HTTP 상태코드: 400(잘못된 요청), 500(서버 에러), 503(수집 실패)"
  },
