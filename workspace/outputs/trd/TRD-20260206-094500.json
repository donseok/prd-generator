        "description": "품질 검사 결과 (15개 항목)",
        "attributes": ["result_id: BIGINT PK", "coil_id: VARCHAR(20) FK", "spec_id: BIGINT FK", "inspection_type: VARCHAR(20)", "measured_values: JSONB", "judgement: VARCHAR(10)", "spc_status: VARCHAR(10)", "surface_images: TEXT[]", "inspected_at: TIMESTAMP", "inspector_id: BIGINT FK"],
        "primary_key": "result_id",
        "relationships": ["N:1 → COIL", "N:1 → QUALITY_SPEC"]
      },
      {
        "name": "QUALITY_SPEC",
        "description": "고객별 품질 규격",
        "attributes": ["spec_id: BIGINT PK", "customer_id: BIGINT FK", "spec_name: VARCHAR(100)", "criteria: JSONB", "is_active: BOOLEAN"],
        "primary_key": "spec_id",
        "relationships": ["N:1 → CUSTOMER", "1:N → QUALITY_RESULT"]
      },
      {
        "name": "EQUIPMENT",
        "description": "설비 마스터 (13개 주요 설비)",
        "attributes": ["equip_id: BIGINT PK", "line_id: BIGINT FK", "equip_code: VARCHAR(20)", "equip_name: VARCHAR(100)", "equip_type: VARCHAR(30)", "status: VARCHAR(20)", "oee_target: DECIMAL(5,2)", "last_maintenance: TIMESTAMP"],
        "primary_key": "equip_id",
        "relationships": ["N:1 → PRODUCTION_LINE", "1:N → EQUIPMENT_EVENT", "1:N → ROLL_HISTORY"]
      },
      {
        "name": "SCHEDULE",
        "description": "생산 스케줄 (월/주/일)",
        "attributes": ["schedule_id: BIGINT PK", "schedule_type: VARCHAR(10)", "plan_start: DATE", "plan_end: DATE", "status: VARCHAR(20)", "version: INT", "created_by: BIGINT FK", "created_at: TIMESTAMP", "constraints_applied: JSONB"],
        "primary_key": "schedule_id",
        "relationships": ["1:N → SCHEDULE_DETAIL"]
      },
      {
        "name": "APS_CONSTRAINT",
        "description": "APS 제약조건 (CR-001~015)",
        "attributes": ["constraint_id: VARCHAR(10) PK", "constraint_type: VARCHAR(20)", "target_process: VARCHAR(10)", "name: VARCHAR(100)", "parameters: JSONB", "priority: VARCHAR(5)", "is_active: BOOLEAN", "updated_at: TIMESTAMP"],
        "primary_key": "constraint_id",
        "relationships": []
      },
      {
        "name": "TAG_DATA (TimescaleDB)",
        "description": "시계열 태그 데이터. 7,200태그 × 1초 주기. Hypertable.",
        "attributes": ["time: TIMESTAMPTZ PK", "tag_id: VARCHAR(50) PK", "line_id: SMALLINT", "value: DOUBLE PRECISION", "quality: SMALLINT"],
        "primary_key": "time + tag_id (composite)",
        "relationships": []
      }
    ],
    "indexing_strategy": "COIL: (status, current_process) 공정별 WIP, (current_location) 야드 검색. COIL_HISTORY: (coil_id, event_timestamp DESC) 이력 조회. WORK_ORDER: (line_id, status) 라인 큐, (planned_start) 일정. QUALITY_RESULT: (coil_id) 코일별, (spc_status, inspected_at) SPC. TAG_DATA: TimescaleDB 자동 인덱스(time, tag_id).",
    "partitioning_strategy": "COIL_HISTORY: 월별 파티셔닝(3년 온라인 → 아카이브). QUALITY_RESULT: 월별 파티셔닝. TAG_DATA: TimescaleDB 일별 청크, 1년 상세 → 5년 요약 Continuous Aggregate. 감사 로그: Elasticsearch ILM(30일 Hot → 1년 Warm → 10년 Cold)."
  },
