{
  "id": "TRD-20260305-162132",
  "title": "시스템 모니터링 웹 대시보드 TRD",
  "executive_summary": "본 프로젝트는 로컬 서버의 CPU, 메모리, 디스크, 네트워크 리소스를 실시간으로 시각화하는 경량 웹 대시보드를 구축한다. 프론트엔드는 React + Recharts 기반, 백엔드는 Python + FastAPI + psutil 조합으로 REST API를 제공한다. 2계층 모놀리식 아키텍처를 채택하며, 프론트엔드 폴링(3초 간격)으로 실시간성을 구현한다. 데이터베이스 없이 인메모리 방식으로 운영하며, Docker를 통해 배포 편의성을 확보한다.",
  "technology_stack": [
    {
      "category": "Frontend",
      "technologies": ["React 18.x", "TypeScript 5.x", "Recharts 2.x", "Vite 5.x", "CSS Modules"],
      "rationale": "React와 Recharts는 PRD 제약조건(CON-001)에 의해 지정. Vite는 빠른 HMR과 경량 번들링. TypeScript로 타입 안전성 확보."
    },
    {
      "category": "Backend",
      "technologies": ["Python 3.11+", "FastAPI 0.110+", "psutil 5.9+", "Uvicorn 0.29+"],
      "rationale": "Python과 psutil은 PRD 제약조건(CON-002)에 의해 지정. FastAPI는 비동기 지원, 자동 API 문서 생성, 고성능 ASGI 프레임워크."
    },
    {
      "category": "DevOps",
      "technologies": ["Docker 24+", "Docker Compose 2.x"],
      "rationale": "환경 일관성 보장 및 프론트엔드/백엔드 동시 실행 편의성."
    }
  ],
  "system_architecture": {
    "overview": "2계층 클라이언트-서버 아키텍처. React 프론트엔드가 3초 간격으로 FastAPI 백엔드를 폴링하여 시스템 메트릭을 수집하고 Recharts로 시각화한다.",
    "architecture_style": "모놀리식",
    "layers": [
      {
        "name": "Presentation Layer",
        "description": "React 기반 대시보드 UI, 차트 렌더링, 다크 테마, 반응형 레이아웃",
        "components": [
          {
            "name": "DashboardLayout",
            "type": "컴포넌트",
            "description": "2x2 반응형 그리드 레이아웃 컨테이너",
            "responsibilities": ["차트 배치", "반응형 그리드 관리"],
            "dependencies": ["CpuChart", "MemoryChart", "DiskChart", "NetworkChart"],
            "interfaces": []
          },
          {
            "name": "CpuChart",
            "type": "컴포넌트",
            "description": "CPU 사용률 실시간 라인 차트",
            "responsibilities": ["CPU 데이터 시각화", "시간축 트렌드 표시"],
            "dependencies": ["Recharts", "useSystemMetrics"],
            "interfaces": []
          },
          {
            "name": "MemoryChart",
            "type": "컴포넌트",
            "description": "메모리 사용률 실시간 라인 차트",
            "responsibilities": ["메모리 데이터 시각화", "전체/사용 용량 표시"],
            "dependencies": ["Recharts", "useSystemMetrics"],
            "interfaces": []
          },
          {
            "name": "DiskChart",
            "type": "컴포넌트",
            "description": "디스크 사용량 파이 차트",
            "responsibilities": ["드라이브별 디스크 사용량 시각화"],
            "dependencies": ["Recharts", "useSystemMetrics"],
            "interfaces": []
          },
          {
            "name": "NetworkChart",
            "type": "컴포넌트",
            "description": "네트워크 IN/OUT 트래픽 라인 차트",
            "responsibilities": ["수신/송신 트래픽 구분 시각화"],
            "dependencies": ["Recharts", "useSystemMetrics"],
            "interfaces": []
          },
          {
            "name": "useSystemMetrics",
            "type": "Hook",
            "description": "3초 간격 폴링 및 데이터 상태 관리",
            "responsibilities": ["API 폴링", "데이터 포인트 관리 (FIFO 60개)", "에러 처리"],
            "dependencies": [],
            "interfaces": ["GET /api/v1/system/all"]
          }
        ]
      },
      {
        "name": "API Layer",
        "description": "FastAPI REST 엔드포인트, CORS 처리, 응답 직렬화",
        "components": [
          {
            "name": "SystemRouter",
            "type": "라우터",
            "description": "시스템 메트릭 API 라우터",
            "responsibilities": ["엔드포인트 정의", "요청/응답 처리"],
            "dependencies": ["MetricsCollector"],
            "interfaces": ["/api/v1/system/*"]
          }
        ]
      },
      {
        "name": "Service Layer",
        "description": "시스템 메트릭 수집 비즈니스 로직",
        "components": [
          {
            "name": "MetricsCollector",
            "type": "서비스",
            "description": "psutil 래퍼 서비스. CPU, 메모리, 디스크, 네트워크 메트릭 수집",
            "responsibilities": ["시스템 메트릭 수집", "네트워크 초당 전송량 계산", "데이터 정규화"],
            "dependencies": ["psutil"],
            "interfaces": ["get_cpu()", "get_memory()", "get_disk()", "get_network()", "get_all()"]
          }
        ]
      }
    ],
    "data_flow": "브라우저 → 3초 Timer → GET /api/v1/system/all → FastAPI Router → MetricsCollector → psutil → OS 메트릭 → JSON Response → React State 업데이트 → Recharts 렌더링",
    "deployment_diagram": "Docker Compose로 frontend(Port 3000)와 backend(Port 8000) 두 컨테이너를 단일 호스트에서 실행. 프론트엔드는 Vite dev server 또는 Nginx로 정적 파일 서빙."
  },
