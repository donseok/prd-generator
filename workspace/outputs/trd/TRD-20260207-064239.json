    "data_flow": "Level 2 (PLC/HMI) → OPC-UA Server → Edge Gateway → Kafka → MES Service → PostgreSQL/TimescaleDB. SAP 수주 → Kafka → APS Service → 스케줄링 → MES Service → 작업지시. 품질 데이터 → Quality Service → SPC 판정 → 알람/Hold.",
    "deployment_diagram": "On-Premise: Kubernetes Cluster (Rancher RKE2) - APS, MES, Quality, Equipment Services + PostgreSQL, TimescaleDB, Redis, Kafka. Cloud (AWS EKS): Analytics, Report, Notification Services + RDS Read Replica, S3 Data Lake. DMZ: Edge Gateway 9대 (라인당 1대)."
  },
  "database_design": {
    "database_type": "RDBMS + 시계열DB",
    "recommended_engine": "PostgreSQL 16 + TimescaleDB 2.13",
    "entities": [
      {
        "name": "coil",
        "description": "코일 마스터 및 상태",
        "attributes": [
          "coil_id: VARCHAR(20) PK",
          "parent_coil_id: VARCHAR(20) FK",
          "steel_grade_id: VARCHAR(20) FK",
          "thickness: DECIMAL(6,3)",
          "width: DECIMAL(6,1)",
          "weight: DECIMAL(10,2)",
          "length: DECIMAL(10,2)",
          "status: VARCHAR(20)",
          "current_location: VARCHAR(50)",
          "quality_grade: VARCHAR(10)",
          "created_at: TIMESTAMPTZ",
          "updated_at: TIMESTAMPTZ"
        ],
        "primary_key": "coil_id",
        "relationships": ["1:N coil_genealogy", "1:N work_order", "1:N quality_inspection"]
      },
      {
        "name": "work_order",
        "description": "작업지시",
        "attributes": [
          "work_order_id: BIGSERIAL PK",
          "plan_id: BIGINT FK",
          "coil_id: VARCHAR(20) FK",
          "process_line_id: VARCHAR(20) FK",
          "sequence: INTEGER",
          "status: VARCHAR(20)",
          "planned_start_time: TIMESTAMPTZ",
          "planned_end_time: TIMESTAMPTZ",
          "actual_start_time: TIMESTAMPTZ",
          "actual_end_time: TIMESTAMPTZ",
          "priority: INTEGER",
          "is_urgent: BOOLEAN"
        ],
        "primary_key": "work_order_id",
        "relationships": ["N:1 production_plan", "N:1 coil", "1:N production_result"]
      },
      {
        "name": "production_plan",
        "description": "생산계획",
        "attributes": [
          "plan_id: BIGSERIAL PK",
          "plan_type: VARCHAR(20)",
          "plan_date: DATE",
          "status: VARCHAR(20)",
          "created_by: VARCHAR(50)",
          "confirmed_by: VARCHAR(50)",
          "confirmed_at: TIMESTAMPTZ"
        ],
        "primary_key": "plan_id",
        "relationships": ["1:N work_order"]
      },
      {
        "name": "quality_inspection",
        "description": "품질 검사",
        "attributes": [
          "inspection_id: BIGSERIAL PK",
          "coil_id: VARCHAR(20) FK",
          "process_line_id: VARCHAR(20) FK",
          "inspection_type: VARCHAR(50)",
          "result_value: JSONB",
          "judgement: VARCHAR(20)",
          "inspected_at: TIMESTAMPTZ",
          "inspector_id: VARCHAR(50)"
        ],
        "primary_key": "inspection_id",
        "relationships": ["N:1 coil"]
      },
      {
        "name": "tag_data",
        "description": "Level 2 태그 데이터 (TimescaleDB Hypertable)",
        "attributes": [
          "time: TIMESTAMPTZ PK",
          "tag_id: VARCHAR(100) PK",
          "value: DOUBLE PRECISION",
          "quality: INTEGER",
          "process_line_id: VARCHAR(20)"
        ],
        "primary_key": "time, tag_id",
        "relationships": []
      },
      {
        "name": "equipment",
        "description": "설비 마스터",
        "attributes": [
          "equipment_id: VARCHAR(20) PK",
          "process_line_id: VARCHAR(20) FK",
          "equipment_name: VARCHAR(100)",
          "equipment_type: VARCHAR(50)",
          "status: VARCHAR(20)",
          "installed_date: DATE"
        ],
        "primary_key": "equipment_id",
        "relationships": ["N:1 process_line", "1:N equipment_event"]
      }
    ],
    "indexing_strategy": "coil: status, location, steel_grade 복합 인덱스. work_order: status+line, planned_time 인덱스. tag_data: TimescaleDB 자동 인덱싱 (time + tag_id). 검색용 Elasticsearch 인덱스 (코일 검색, 클레임 역추적).",
    "partitioning_strategy": "production_result: 월별 Range 파티션 (3년 온라인, 10년 아카이브). tag_data: 일별 Hypertable chunk (1년 상세, 5년 요약). audit_log: 월별 파티션 (7년 보관)."
  },
  "api_specification": {
    "base_url": "/api/v1",
    "authentication_method": "JWT (OAuth 2.0 + OpenID Connect)",
