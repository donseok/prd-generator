# Validation Settings
AUTO_APPROVE_THRESHOLD=0.8
ENABLE_PM_REVIEW=false
ENABLE_CONFLICT_DETECTION=false
CLAUDE_MODEL=sonnet

# API Key (optional - only needed when using Anthropic API directly, not needed with Claude CLI)
# ANTHROPIC_API_KEY=

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated origins, default: http://localhost:3000)
# ALLOWED_ORIGINS=["http://localhost:3000"]

# File Upload Limits
# MAX_FILE_SIZE_MB=50
# MAX_TOTAL_UPLOAD_MB=200
